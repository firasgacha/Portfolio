{
  "name": "portfolio",
  "homepage": "https://firasgacha.github.io/Portfolio",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "preinstall": "node -e \"process.version.startsWith('v24.') || (console.error('Error: Node.js 24.x is required. Current: ' + process.version), process.exit(1))\"",
    "dev": "vite",
    "clean": "rm -rf dist",
    "build": "tsc -b && vite build && cp dist/index.html dist/404.html",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "i18next": "^25.8.14",
    "i18next-browser-languagedetector": "^8.2.1",
    "jspdf": "^4.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.18.1",
    "remixicon": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "daisyui": "^5.7.27",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^16.0.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.0.1",
    "vite": "^8.2.0",
    "vitest": "^3.2.4"
  }
}
